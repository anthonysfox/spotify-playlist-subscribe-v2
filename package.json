{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate",
    "apple:check": "tsx scripts/apple-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db:up": "docker compose up -d --wait postgres-test",
    "test:db:down": "docker compose down",
    "test:db:migrate": "POSTGRES_URL_NON_POOLING=postgresql://test:test@localhost:5433/playlistfox_test prisma migrate deploy",
    "test:integration": "POSTGRES_URL_NON_POOLING=postgresql://test:test@localhost:5433/playlistfox_test vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.12",
    "@ai-sdk/react": "^4.0.45",
    "@clerk/nextjs": "^6.39.6",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.2.0",
    "ai": "^7.0.23",
    "jose": "^6.2.3",
    "lucide-react": "^0.507.0",
    "marked": "^18.0.9",
    "mcp-handler": "^1.1.0",
    "next": "15.5.22",
    "pg": "^8.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^10.1.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "eslint": "8.11.0",
    "eslint-config-next": "^13.0.5",
    "postcss": "^8.4.12",
    "prisma": "^7.2.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.3",
      "postcss": "^8.5.23"
    }
  }
}
